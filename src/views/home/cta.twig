<section
  data-appear
  id="{{ id }}"
  class="HomeSection FramedCta HomeSection--framedcta is-visible"
  data-bg="yellow"
>
  <div class="Container">
    <div class="FramedCTA__Copy">
      <div class="FramedCTA__Heading Heading">
        <span class="FramedCTA__SubTitle SmallCaps">{{ subtitle }}</span>
        <p>
          {{ title }}
        </p>
        <a class="Button Button--black Button--large" href="{{ url }}">
          {{ buttonText }}
        </a>
      </div>
    </div>
  </div>
</section>
