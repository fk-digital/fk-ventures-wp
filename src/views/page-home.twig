{% extends 'base.twig' %}
{% block content %}
  <h1 class="sr-only">FutureKings Ventures, Brand-led venture investing</h1>

  {% include 'home/centered.twig' with {
    id: 'brand-led',
    text: 'Brand-led <strong>venture investing</strong>'
  } %}

  {% include 'home/centered.twig' with {
    id: 'fund',
    text: 'We fund <strong>high-impact</strong> brand programmes for carefully selected startups in exchange for equity.'
  } %}

  {% include 'home/investment.twig' %}

  {% include 'home/portfolio.twig' %}

  {% include 'home/centered.twig' with {
    id: 'soon',
    text: 'Applications are <strong>opening soon</strong> for our third.'
  } %}

  {% include 'home/what.twig' %}

  {% include 'home/why.twig' %}

  {% include 'home/case-study.twig' with {
    id: 'heidi',
    client: 'Heidi',
    sector: 'Travel',
    program: 'minimum viable brand',
    logo: 'heidi/heidi.svg',
    name: 'Marcus Blunt',
    linkedin: 'https://www.linkedin.com/in/marcus-blunt-b8b07422/',
    qoute: '"We found FutureKings at a critical time for the business, we knew we had built something disruptive, but the brand wasn&apos;t telling the story - both to investors and to customers. This programme changed that."',
    jobTitle: 'co-founder, Heidi',
    stat1Prefix: '£',
    stat1Number: '5.6',
    stat1Sufix: 'm',
    stat1Desc: 'VC funding secured',
    stat2Number: '300',
    stat2Sufix: '%',
    stat2Desc: 'Revenue increase',
    caseStudyLink: '/case-studies/heidi/',
    images: [
      {
        src: theme.link ~ '/assets/images/heidi/1.png',
        alt: 'The Carifit App'
      },
      {
        src: theme.link ~ '/assets/images/heidi/2.png',
        alt: 'Carifits Organising Idea, "Stronger Together"'
      },
      {
        src: theme.link ~ '/assets/images/heidi/3.png',
        alt: 'Example Carifit Ad, saying "Ready for the ups and downs of parenting"'
      },
      {
        src: theme.link ~ '/assets/images/heidi/4.png',
        alt: 'The Carifit Packaging'
      },
      {
        src: theme.link ~ '/assets/images/heidi/5.png',
        alt: 'Example Carifit mailer '
      },
      {
        src: theme.link ~ '/assets/images/heidi/6-small.gif',
        alt: 'Photo of the carifit carrier'
      }
    ]
  } %}

  {% include 'home/about.twig' %}

  {% include 'home/power.twig' %}

  {% include 'home/cta.twig' with {
    id: 'register-interest',
    url: '/apply/',
    subtitle: 'apply',
    title: 'Applications will open soon.',
    buttonText: 'Register Interest'
  } %}
{% endblock %}
